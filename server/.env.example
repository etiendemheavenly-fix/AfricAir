# AfricAir API runtime configuration. Copy to .env and adjust. Every value is optional.
# Settings are read at startup: change them, then restart the API (or roll the pods).

PORT=4000
METRICS_PORT=9464
APP_ENV=local                     # shown as a coloured banner; hidden when "production"
APP_VERSION=dev                   # shown in the banner and on /#/status (set from CI)
GIT_SHA=unknown

BRAND_NAME=AfricAir               # header, footer and page title
SUPPORT_EMAIL=support@africair.example
SUPPORT_PHONE=
ANNOUNCEMENT_TEXT=                # site-wide banner under the header
ANNOUNCEMENT_LEVEL=info           # info | warning | critical
DEFAULT_LANGUAGE=                 # en | fr  (for visitors who have not chosen one)
DEFAULT_CURRENCY=                 # e.g. KES, NGN, EUR
SERVICE_FEE_USD=15                # fee added to every booking
MAINTENANCE_MODE=false            # true = bookings paused (search still works)
FEATURE_DESTINATIONS=true         # false hides the Destinations page
FEATURE_MY_TRIPS=true             # false hides My trips
FEATURE_PROMO_CODES=true          # promo box appears only if this is true AND PROMO_CODES is set

# ---- Secrets: use NAME=value, or NAME_FILE=/path (file secrets reload without a restart) ----
# DATABASE_URL=postgres://africair:password@localhost:5432/africair   # enables server-side bookings
# DATABASE_URL_FILE=/run/secrets/database_url
# (or the libpq variables PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD)
DB_SSL=                           # disable | require | verify  (verify needs DB_SSL_CA_FILE)
DB_SSL_CA_FILE=
MIGRATE_ON_START=false            # or run `node dist/migrate.js` as a separate job

# ADMIN_TOKEN=change-me           # unlocks /#/admin
# ADMIN_TOKEN_FILE=/run/secrets/admin_token
# PROMO_CODES=SAVE10:10,AFRICA20:20   # CODE:percent list, or JSON {"SAVE10":10}
# PROMO_CODES_FILE=/run/secrets/promo_codes

SECRET_REFRESH_SECONDS=10         # how often *_FILE secrets are re-read
EXPOSE_SECRET_FINGERPRINTS=       # default: true unless APP_ENV=production
SHUTDOWN_DELAY_MS=5000            # readiness fails this long before the server stops on SIGTERM
LOG_LEVEL=info                    # debug | info | warn | error
