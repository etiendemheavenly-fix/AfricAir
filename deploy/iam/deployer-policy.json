{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAfricAirSiteBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::africair-live-web-bb07152365ee"
    },
    {
      "Sid": "PublishAfricAirSiteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::africair-live-web-bb07152365ee/*"
    },
    {
      "Sid": "UploadAfricAirDeploymentArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::africair-live-deploy-bb07152365ee/*"
    },
    {
      "Sid": "InvalidateAfricAirCloudFrontDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::204685625557:distribution/E1UPIC1HV4OLH8"
    }
  ]
}
