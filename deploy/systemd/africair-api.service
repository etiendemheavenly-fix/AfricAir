[Unit]
Description=AfricAir API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=africair
Group=africair
WorkingDirectory=/opt/africair/api/current/server
EnvironmentFile=-/etc/africair/api.env
LoadCredential=admin_token:/etc/africair/secrets/admin_token
LoadCredential=promo_codes:/etc/africair/secrets/promo_codes
LoadCredential=database_url:/etc/africair/secrets/database_url
Environment=ADMIN_TOKEN_FILE=%d/admin_token
Environment=PROMO_CODES_FILE=%d/promo_codes
Environment=DATABASE_URL_FILE=%d/database_url
ExecStart=/usr/bin/node /opt/africair/api/current/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s
KillSignal=SIGTERM
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M
UMask=0077

[Install]
WantedBy=multi-user.target
